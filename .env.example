# Server-only — never prefix with NEXT_PUBLIC_, never read from a "use client" file.
# Copy to .env.local and fill in real values. Both are optional: the CRM
# and lead form work normally with neither set (see src/lib/notifications/).

# [Phase 7] n8n webhook — receives { event, detail, lead } as JSON on lead
# creation / status change. Point this at a real n8n webhook trigger to
# fan lead events out to email/Slack/WhatsApp/Sheets/etc. from there.
N8N_WEBHOOK_URL=

# [Phase 6] Internal notification recipient — currently only used to
# report "Configured" status in /admin/marketing. Actual email sending is
# not implemented yet (see src/lib/notifications/channels/emailChannel.ts) —
# setting this alone does not send anything.
NOTIFY_EMAIL_TO=

# [Phase 1 — Authentication Foundation] No new required env var.
# Sessions are opaque, cryptographically random server-side tokens
# (see src/lib/auth/sessionsRepository.ts) looked up in data/sessions.json
# — not signed JWTs — so there is no signing secret to configure. The
# first admin account is created through a real form at /admin/setup
# (available only until the first account exists), never a seeded
# credential or env var.

# [Phase 3+] Supabase connection. Do not fill with placeholder/invented
# values — leave blank until you have a real project.
#
# Safe to expose to the browser (RLS enforces access control, not secrecy
# of these two) — project URL + publishable key, from Supabase Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, NEVER import into a "use
# client" file or any code path reachable by a public request. Bypasses
# Row Level Security entirely. Used by the CMS repositories
# (src/lib/cms/supabase/**, service-role by design — see those files'
# header comments) and one-off migration/QA scripts under scripts/.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token (Supabase account, not a project API key) — only
# needed to run `supabase db push` via .supabase-cli/. Never used at
# application runtime.
SUPABASE_ACCESS_TOKEN=

# [Phase 4] "supabase" switches CMS + CRM reads/writes from data/*.json to
# Supabase, both directions together per domain (see
# src/lib/cms/dataBackend.ts's header comment for why never split). Unset
# or any other value means JSON — the entire rollback mechanism.
DATA_BACKEND=

# [Phase 5 — Public user auth] Used to build the password-reset email's
# redirect link (src/app/api/auth/user/forgot-password/route.ts) and the
# signup email-confirmation redirect (src/app/api/auth/user/signup/route.ts).
# Falls back to http://localhost:3000 if unset — correct for local dev,
# and deliberately left unset in .env.local until the app is actually
# deployed (setting it here would send real Supabase auth emails a
# localhost dev instance can't act on). [Phase 7] Production target for
# this project is https://thanksux.com — set it to that exact value in
# the real deployment's environment (not in this local .env file) once
# the domain is live. Does not affect Supabase's own Auth "Site URL"
# setting (Supabase dashboard, separate from this app-level var) — that
# is unrelated infrastructure config, not changed by this project's code.
NEXT_PUBLIC_SITE_URL=
