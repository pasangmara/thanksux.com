# ─────────────────────────────────────────────────────────────
# ARGUS Client Hub: environment variables
# Copy to .env.local for local work. Set the same keys in Vercel.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Postgres connection string. Leave EMPTY to run in demo mode (sample data in .data/).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Public URL of this app. Used to build client links: <PUBLIC_BASE_URL>/feedback/<code>
# Leave empty locally (it uses the request host).
# PUBLIC_BASE_URL=https://feedback.argusofficial.com
PUBLIC_BASE_URL=

# First admin. Only used while the team table is empty: the first login with
# these exact values creates the admin. Remove ADMIN_PASSWORD after that.
# (Or use: npm run admin:create -- --email you@example.com)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Joy Howlader

# n8n (optional; can also be set in Dashboard → Settings). Env values win.
# N8N_WEBHOOK_URL=https://your-n8n.app.n8n.cloud/webhook/argus-client-hub
# N8N_WEBHOOK_SECRET=   # long random string; n8n verifies X-Argus-Signature with it
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Protects /api/cron/daily and /api/cron/outbox (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Only for preview deployments that should run on sample data without a database.
# ALLOW_DEMO_IN_PRODUCTION=true
